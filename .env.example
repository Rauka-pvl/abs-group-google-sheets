# Bitrix24 incoming webhook URL (must end with /)
# Example: https://example.bitrix24.kz/rest/1/xxxxxxxx/
BITRIX_WEBHOOK_URL=

# Google Spreadsheet ID from the URL
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1n0UXLH3DnoEjuopp_2W8KFu9Rs8BY43WEI1KykgKujM

# Sheet tab name
SHEET_NAME=Снабжения

# Path to Google service account JSON key
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Outgoing webhook application_token from Bitrix
OUTGOING_WEBHOOK_TOKEN=

# HTTP port for webhook server (POST /action)
PORT=3000
