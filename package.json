{
  "name": "abs-bitrix-google-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Sync Bitrix24 accounting SPA cards to Google Sheets",
  "type": "module",
  "scripts": {
    "sync": "tsx src/cli.ts",
    "sync:dry": "tsx src/cli.ts --dry-run",
    "sync:preview": "tsx src/cli.ts --preview",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/qs": "^6.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
