{
  "name": "abs-bitrix-google-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Sync Bitrix24 accounting SPA cards to Google Sheets",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "sync": "node dist/cli.js",
    "sync:dry": "node dist/cli.js --dry-run",
    "sync:preview": "node dist/cli.js --preview",
    "dev": "tsx watch src/server.ts",
    "dev:sync": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/qs": "^6.15.1",
    "tsx": "^4.19.2"
  }
}
